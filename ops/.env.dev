# 笔境 · dev 环境变量
# 反馈功能开启，自动持续部署

HOST_PORT=8080
NODE_ENV=development
ENABLE_FEEDBACK=true

# 数据库（本地 PostgreSQL）
DB_USER=bijing
DB_PASSWORD=bijing123
DB_NAME=bijing
DATABASE_URL=postgresql://bijing:bijing123@db:5432/bijing

# Kimi AI（需要替换为有效 key）
KIMI_API_KEY=${KIMI_API_KEY}
KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_MODEL=moonshot-v1-8k
