# 笔境 · main 环境变量
# 反馈功能关闭，部署需用户授权

HOST_PORT=80
NODE_ENV=production
ENABLE_FEEDBACK=false

# 数据库（生产环境建议改为更强密码或外部托管）
DB_USER=bijing
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=bijing
DATABASE_URL=postgresql://bijing:CHANGE_ME_STRONG_PASSWORD@db:5432/bijing

# Kimi AI（需要替换为有效 key）
KIMI_API_KEY=${KIMI_API_KEY}
KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_MODEL=moonshot-v1-8k
